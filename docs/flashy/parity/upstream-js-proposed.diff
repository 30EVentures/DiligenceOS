@@ -15,7 +15,9 @@
 export function verifyInvoice(inv, pinnedSellerPub, now) {
   if (!inv || typeof inv !== 'object' || Object.keys(inv).sort().join() !== [...INVOICE_KEYS].sort().join()) return false // closed schema
   if (inv.ver !== '30e-demo-invoice/1' || inv.sellerKey !== pinnedSellerPub) return false
-  if (typeof inv.amount !== 'string' || !/^(0|[1-9][0-9]*)$/.test(inv.amount) || !ALLOWED_CHAINS[inv.chain]) return false
+  if (typeof inv.amount !== 'string' || !/^[1-9][0-9]*$/.test(inv.amount) || !ALLOWED_CHAINS[inv.chain]) return false // positive integer string
+  if (typeof inv.payee !== 'string' || !ADDR.test(inv.payee) || typeof inv.asset !== 'string' || !ADDR.test(inv.asset)) return false
+  if (typeof inv.expiresAt !== 'string' || !/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d{1,3})?Z$/.test(inv.expiresAt)) return false // Date.parse alone accepts "2030" and "Jan 1 2030"
   const { sig, ...body } = inv
   return verifyDoc(pinnedSellerPub, INV, body, sig) && Date.parse(inv.expiresAt) > now.getTime()
 }
